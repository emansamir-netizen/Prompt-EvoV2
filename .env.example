# PromptEvo environment template
# Copy this file to .env and add your provider settings and API keys.

# API keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
TARGET_GROQ_API_KEY=""
OPENROUTER_API_KEY=""
TARGET_OPENROUTER_API_KEY=""

# Local-only enforcement
LOCAL_ONLY=false

# Disable auth for local development
PROMPTEVO_DEV_DISABLE_AUTH=true
DRY_RUN=false

# Ollama settings
OLLAMA_BASE_URL="http://localhost:11434"

# Core models
TARGET_PROVIDER=groq
TARGET_MODEL=llama-3.1-8b-instant
ALLOW_MOCK_TARGET=false

ANALYST_PROVIDER=ollama
ANALYST_MODEL=llama3.1

PRIMARY_JUDGE_PROVIDER=ollama
PRIMARY_JUDGE_MODEL=llama3.1

JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1

PROMETHEUS_PROVIDER=ollama
PROMETHEUS_MODEL=llama3.1

# Light roles
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=gemma2

ATTACKER_PROVIDER=ollama
ATTACKER_MODEL=dolphin-llama3
SCOUT_PROVIDER=ollama
SCOUT_MODEL=dolphin-llama3

GOAL_GENERATOR_PROVIDER=ollama
GOAL_GENERATOR_MODEL=dolphin-llama3
SCENARIO_GENERATOR_PROVIDER=ollama
SCENARIO_GENERATOR_MODEL=dolphin-llama3

INQUIRYER_PROVIDER=ollama
INQUIRYER_MODEL=dolphin-llama3
INJECTOR_PROVIDER=ollama
INJECTOR_MODEL=dolphin-llama3
MUTATION_PROVIDER=ollama
MUTATION_MODEL=dolphin-llama3

HIVE_MIND_PROVIDER=ollama
HIVE_MIND_MODEL=dolphin-llama3

LIGHTWEIGHT_CLASSIFIER_PROVIDER=deberta
LIGHTWEIGHT_CLASSIFIER_MODEL=microsoft/deberta-v3-base

CLASSIFIER_PROVIDER=ollama
CLASSIFIER_MODEL=llama3.1

# Ollama performance tuning
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=4096
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBED_TIMEOUT_SECONDS=60
OLLAMA_MAX_PROMPT_CHARS=24000
OLLAMA_TRUNCATE_PROMPT=true

# Logging and runtime
LOG_LEVEL=INFO
MAX_SESSION_TURNS=30
PROMPTEVO_MOMENTUM_BUDGET_FLOOR=12
PROMPTEVO_STOP_ON_FIRST_HIT=true
PROMPTEVO_FP_GUARDS=false
PROMPTEVO_FAST_DEBUG=true
FAST_DEBUG_DISABLE_RED_DEBATE=false
FAST_DEBUG_MAX_DOMAIN_PROBES=2
FAST_DEBUG_MAX_SCENARIOS=3
FAST_DEBUG_JUDGE_MODEL=llama3.1
DEBERTA_ENABLED=false
PROMPTEVO_STRUCTURED_BEHAVIORAL_PROBES=true
PROMPTEVO_SKIP_BEHAVIORAL_WARMUP=true
PROMPTEVO_ALIGNMENT_DIVERGENCE_MIN=true
PROMPTEVO_STRICT_GOALLOCK=true
PROMPTEVO_HALLUCINATION_CLASSIFIER=true
PROMPTEVO_CONTROLLED_EXCLUSIVE_FORK=true
PROMPTEVO_STRICT_ANCHOR_OVERLAP=false
PROMPTEVO_MCTS_PARTIAL_REWARD=true
PROMPTEVO_MEMORY_CONTAMINATION_GUARD=true
PROMPTEVO_HALLUCINATION_TOLERANCE=false
